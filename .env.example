# ── Required ──────────────────────────────────────────────────────────────────
# Strong random password for PostgreSQL.  Generate: openssl rand -base64 32
# POSTGRES_PASSWORD=

# Strong random password for Redis.  Generate: openssl rand -base64 32
# REDIS_PASSWORD=

# Random string used to sign session cookies (min. 32 characters).  Generate: openssl rand -base64 32
# SESSION_SECRET=

# Public URL the app is reachable at — used for OIDC redirects and cookies. (Can be https://192.168.2.100:3000)
# APP_URL=https://yourdomain.com


# ── Database ──────────────────────────────────────────────────────────────────
# POSTGRES_DB=bifi
# POSTGRES_USER=bifi


# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
# In production this is the port users access the app on.
PORT=3000
# Dev only: Vite frontend dev server port — open this in the browser during development.
# VITE_PORT=5173
TZ=Europe/Berlin

# Set to true when running behind a trusted reverse proxy (nginx, Traefik, …).
# TRUST_PROXY=false
# Directory for uploaded images. Default is fine when using the Docker volume.
# UPLOAD_DIR=/app/uploads


# ── Features ──────────────────────────────────────────────────────────────────
# JACKPOT_ENABLED=false
# BALANCE_WARN_THRESHOLD=-2000
# Maximum deposit per transaction in cents (10000 = 100 €).
# MAX_DEPOSIT_AMOUNT=10000
# ALLOW_NEGATIVE_BALANCE=true


# ── Authentication ────────────────────────────────────────────────────────────
# Disable to enforce OIDC-only login.
# LOCAL_AUTH_ENABLED=true

# OIDC / SSO — uncomment all three to enable single sign-on.
# OIDC_ISSUER=https://auth.example.com/application/o/bifi/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# If local login is disabled, should the user be automatically redirected?
# OIDC_AUTO_REDIRECT=false
# always = sync role on every login | on_creation = only on first login | never = disabled
# ROLE_SYNC=always

# OIDC claim to use as the display name. Defaults to name, falls back to email.
# OIDC_USERNAME_CLAIM=name

# Name of the claim that contains group memberships.
# OIDC_GROUPS_CLAIM=groups
# Group values that grant admin / moderator roles.
# Users in neither group get the "member" role.
# OIDC_ADMIN_GROUP=bifi-admin
# OIDC_MODERATOR_GROUP=bifi-moderator

# Additional allowed redirect origins for OIDC (APP_URL is always allowed).
# OIDC_ALLOWED_REDIRECT_ORIGINS=https://other.yourdomain.com


# ── Development ───────────────────────────────────────────────────────────────
# Mounts debug API routes at /api/dev and shows the dev banner. Never enable in production.
# VITE_DEV_TOOLS=false

# DATABASE_URL and REDIS_URL are only needed for local dev (outside Docker).
# In Docker both are composed / set automatically.
# DATABASE_URL=postgresql://bifi:<POSTGRES_PASSWORD>@localhost:5432/bifi
# REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379

