# Database
DATABASE_URL=postgresql://bifi:bifi_password@localhost:5432/bifi

# Redis
REDIS_URL=redis://localhost:6379

# Session (min. 32 random characters)
SESSION_SECRET=change-me-to-a-random-32-char-string-here

# OIDC (leave empty to disable SSO login)
OIDC_ISSUER=https://authentik.yourdomain.com/application/o/bifi/
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# OIDC role mapping — name of the claim that contains group memberships,
# and the group values that grant admin / moderator roles.
# Users in neither group get the "member" role.
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=bifi-admin
OIDC_MODERATOR_GROUP=bifi-moderator

# App
APP_URL=http://localhost:3000
NODE_ENV=development
PORT=3000
TZ=Europe/Berlin

# Features
JACKPOT_ENABLED=false
# always = sync role on every login; on_creation = set role only on first login; never = never sync role
ROLE_SYNC=always
BALANCE_WARN_THRESHOLD=-2000
