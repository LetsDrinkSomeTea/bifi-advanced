{
  "name": "bifi",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "vite",
    "dev:local": "dotenv -e .env -- concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "vite build",
    "start": "tsx server/src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:generate:local": "dotenv -e .env -- drizzle-kit generate",
    "db:migrate:local": "dotenv -e .env -- drizzle-kit migrate",
    "test": "npm run test:server && npm run test:client",
    "test:server": "vitest run --config server/vitest.config.ts",
    "test:client": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p client/tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "check": "npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/zod-validator": "^0.4.3",
    "@hookform/resolvers": "^3.10.0",
    "@scalar/hono-api-reference": "^0.5.0",
    "@tanstack/react-query": "^5.67.0",
    "argon2": "^0.44.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.41.0",
    "file-type": "^22.0.1",
    "framer-motion": "^12.38.0",
    "hono": "^4.7.0",
    "lucide-react": "^0.479.0",
    "openid-client": "^6.5.0",
    "pg": "^8.14.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
    "redis": "^4.7.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.6.0",
    "tailwind-scrollbar-hide": "^4.0.0",
    "wouter": "^3.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.1",
    "prettier": "^3.8.3",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^5.4.14",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.8"
  }
}
