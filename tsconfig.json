{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "paths": {
      "@shared/*": ["./shared/src/*"],
      "@/*": ["./client/src/*"]
    }
  },
  "exclude": ["node_modules", "dist"]
}
